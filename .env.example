# Project
PROJECT_NAME=企业级RAG智能问答系统
PROJECT_VERSION=2.0.0

# Vector store and ingestion
DATA_DIR=./data
VECTOR_DB_DIR=./vector_db
MODELS_DIR=./models
UPLOAD_DIR=./upload
INGESTION_STORAGE_DIR=./data/ingestion
VECTOR_STORE_TYPE=chroma
CHROMA_ANONYMIZED_TELEMETRY=false
CHROMA_COLLECTION_NAME=langchain
EMBEDDING_MODEL_NAME=bge_small_zh
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EXCEL_ROWS_PER_DOCUMENT=30

# Retrieval
SEARCH_TOP_K=5
USE_RERANKER=true
RERANKER_MODEL_NAME=bge_reranker_base

# LLM: siliconflow | openai | ollama
LLM_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:7b

# Service
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
ALLOWED_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=app.log
